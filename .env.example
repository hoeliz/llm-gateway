# Copie para .env e preencha localmente. Nunca versione chaves reais.
GATEWAY_API_KEY=troque-por-uma-chave-local-forte
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LISTEN_ADDR=127.0.0.1:8080
UPSTREAM_TIMEOUT=2m
# URLs devem incluir /v1. Altere apenas para servidores confiáveis.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
